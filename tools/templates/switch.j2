! {{ name }} - {{ dev.stands_for }}
! Generated by tools/render.py from design/network.yaml and lab/lab.yaml. Do not edit by hand.
!
enable
configure terminal
hostname {{ name }}
no ip domain-lookup
ip domain-name netdes.lab
service password-encryption
enable secret {{ lab_secret }}
username admin privilege 15 secret {{ lab_secret }}
!
spanning-tree mode rapid-pvst
{%- if dev.get('stp_priority') %}
spanning-tree vlan {{ vlan_list }} priority {{ dev.stp_priority }}
{%- endif %}
!
{%- for v in vlans %}
vlan {{ v.id }}
 name {{ v.name }}
{%- endfor %}
vlan 999
 name BLACKHOLE
!
{%- if is_access %}
ip dhcp snooping
ip dhcp snooping vlan {{ snoop_vlans }}
no ip dhcp snooping information option
!
{%- endif %}
{%- for p in portchannels %}
interface Port-channel{{ p.po }}
 description {{ p.desc }}
{%- if l3cap %}
 switchport trunk encapsulation dot1q
{%- endif %}
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan {{ p.allowed }}
{%- if p.root_guard %}
 spanning-tree guard root
{%- endif %}
{%- if p.trust %}
 ip dhcp snooping trust
{%- endif %}
{%- endfor %}
!
{%- for i in uplinks %}
interface {{ i.port }}
 description {{ i.desc }}
{%- if l3cap %}
 switchport trunk encapsulation dot1q
{%- endif %}
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan {{ i.allowed }}
{%- if i.root_guard %}
 spanning-tree guard root
{%- endif %}
{%- if i.cost %}
 spanning-tree cost {{ i.cost }}
{%- endif %}
{%- if i.trust %}
 ip dhcp snooping trust
{%- endif %}
{%- if i.po %}
 channel-group {{ i.po }} mode active
{%- endif %}
 no shutdown
{%- endfor %}
!

!
{%- for e in edges %}
interface {{ e.port }}
 description {{ e.desc }}
 switchport mode access
 switchport access vlan {{ e.vlan }}
{%- if e.voice %}
 switchport voice vlan {{ e.voice }}
{%- endif %}
{%- if e.port_security %}
 switchport port-security
 switchport port-security maximum 1
 switchport port-security mac-address sticky
 switchport port-security violation restrict
{%- endif %}
 spanning-tree portfast
 spanning-tree bpduguard enable
 no shutdown
{%- endfor %}
!
{%- for r in unused %}
interface range {{ r }}
 description UNUSED
 switchport mode access
 switchport access vlan 999
 shutdown
{%- endfor %}
!
{%- if l3cap %}
no ip routing
{%- endif %}
interface Vlan10
 description Management
 ip address {{ dev.mgmt }} {{ mgmt_mask }}
 no shutdown
ip default-gateway {{ mgmt_gw }}
!
line con 0
 logging synchronous
line vty 0 4
 login local
 transport input ssh
!
end
write memory
