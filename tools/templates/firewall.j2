! {{ name }} - stand-in for {{ dev.stands_for }}
! Lab mapping: FortiGate HA virtual IP -> HSRP virtual IP (.1); zone policy -> inbound ACLs;
! DHCP split between the two units so either can fail.
! Generated by tools/render.py from design/network.yaml and lab/lab.yaml. Do not edit by hand.
!
enable
configure terminal
hostname {{ name }}
no ip domain-lookup
service password-encryption
enable secret {{ lab_secret }}
username admin privilege 15 secret {{ lab_secret }}
!
{%- for p in pools %}
ip dhcp excluded-address {{ p.net_first }} {{ p.reserved_last }}
ip dhcp excluded-address {{ p.other_first }} {{ p.other_last }}
{%- endfor %}
!
{%- for p in pools %}
ip dhcp pool {{ p.name }}
 network {{ p.network }} {{ p.mask }}
 default-router {{ p.gateway }}
 dns-server {{ dns }}
{%- if p.option43 %}
 option 43 ip {{ p.option43 }}
{%- endif %}
{%- endfor %}
!
{%- for acl in acls %}
ip access-list extended {{ acl.name }}
{%- for r in acl.rules %}
 {{ r }}
{%- endfor %}
{%- endfor %}
!
interface GigabitEthernet0/0/0
 description OUTSIDE - transit VLAN 900 to ITSC
 ip address {{ outside_ip }} {{ outside_mask }}
 standby 90 ip {{ outside_vip }}
 standby 90 priority {{ dev.priority }}
 standby 90 preempt
 no shutdown
!
interface GigabitEthernet0/0/1
 description TRUNK to EB2-MDF-CS (all faculty VLANs)
 no shutdown
!
interface GigabitEthernet0/0/1.999
 description native / blackhole
 encapsulation dot1Q 999 native
!
{%- for s in subifs %}
interface GigabitEthernet0/0/1.{{ s.id }}
 description {{ s.name }}
 encapsulation dot1Q {{ s.id }}
 ip address {{ s.ip }} {{ s.mask }}
 standby {{ s.id }} ip {{ s.gateway }}
 standby {{ s.id }} priority {{ dev.priority }}
 standby {{ s.id }} preempt
{%- if s.acl %}
 ip access-group {{ s.acl }} in
{%- endif %}
!
{%- endfor %}
interface GigabitEthernet0/0/2
 description HA heartbeat (FortiGate HA1/HA2 stand-in)
 ip address {{ ha_ip }} 255.255.255.252
 no shutdown
!
ip route 0.0.0.0 0.0.0.0 {{ itsc_ip }}
!
end
write memory
